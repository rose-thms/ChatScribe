{
  "manifest_version": 3,
  "name": "ChatScribe",
  "version": "1.0.0",
  "description": "Modern Chrome extension for exporting WhatsApp Web conversations.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_title": "ChatScribe",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/parser.js",
        "src/content.js"
      ]
    }
  ]
}